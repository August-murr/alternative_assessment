# Copy to .env and fill in. .env is gitignored.

# --- Modal (https://modal.com/settings/tokens) ---
MODAL_TOKEN_ID=paste-modal-token-id-here
MODAL_TOKEN_SECRET=paste-modal-token-secret-here

# --- Claude Code auth: set ONE of these ---
# Long-lived subscription token from `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=paste-claude-code-oauth-token-here
# Alternative: Claude Console API key (takes precedence over the OAuth token if set)
ANTHROPIC_API_KEY=

# --- Kaggle (optional; only needed if anonymous download fails) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Data prep: secret salt used to re-key all IDs. Keep private. ---
DATA_SALT=change-me-to-a-long-random-string
