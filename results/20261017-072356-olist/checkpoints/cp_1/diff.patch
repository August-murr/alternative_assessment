--- a/REPORT.md
+++ b/REPORT.md
@@ -0,0 +1,6 @@
+# Report
+Baseline (iter 1): LightGBM defaults on order-level features: item count, price sum, freight sum, seller count, promised days (estimated date - purchase time), purchase dow/hour/month, customer state. All known at purchase time; no cross-order features.
+Weaknesses: no seller/geo/product features, no tuning.
+
+## Iter 1 validation
+PR-AUC 0.2564, ROC-AUC 0.6494, Brier 0.1345 (pseudo test positive rate 15.7% vs 7.8% overall, so there is drift).
--- a/feats.py
+++ b/feats.py
@@ -0,0 +1,14 @@
+import pandas as pd
+def build(d):
+    o=pd.read_csv(f"{d}/orders.csv",parse_dates=["order_purchase_timestamp","order_estimated_delivery_date"])
+    it=pd.read_csv(f"{d}/order_items.csv")
+    c=pd.read_csv(f"{d}/customers.csv")
+    g=it.groupby("order_id").agg(n_items=("order_item_id","count"),price=("price","sum"),freight=("freight_value","sum"),n_sellers=("seller_id","nunique")).reset_index()
+    x=o.merge(g,on="order_id",how="left").merge(c[["customer_id","customer_state"]],on="customer_id",how="left")
+    x["est_days"]=(x.order_estimated_delivery_date-x.order_purchase_timestamp).dt.total_seconds()/86400
+    x["dow"]=x.order_purchase_timestamp.dt.dayofweek
+    x["hour"]=x.order_purchase_timestamp.dt.hour
+    x["month"]=x.order_purchase_timestamp.dt.month
+    x["customer_state"]=x.customer_state.astype("category")
+    cols=["n_items","price","freight","n_sellers","est_days","dow","hour","month","customer_state"]
+    return x[["order_id"]+cols],cols
--- a/predict.py
+++ b/predict.py
@@ -0,0 +1,8 @@
+import argparse,pickle,pandas as pd
+from feats import build
+a=argparse.ArgumentParser();a.add_argument("--model-dir");a.add_argument("--data-dir");a.add_argument("--output");a=a.parse_args()
+m,cols,cats=pickle.load(open(f"{a.model_dir}/m.pkl","rb"))
+X,_=build(a.data_dir)
+X["customer_state"]=pd.Categorical(X.customer_state.astype(object),categories=cats)
+X["p_late"]=m.predict_proba(X[cols])[:,1].clip(0,1)
+X[["order_id","p_late"]].to_csv(a.output,index=False)
--- a/train.py
+++ b/train.py
@@ -0,0 +1,10 @@
+import argparse,os,pickle,pandas as pd,lightgbm as lgb
+from feats import build
+a=argparse.ArgumentParser();a.add_argument("--data-dir");a.add_argument("--model-dir");a=a.parse_args()
+X,cols=build(a.data_dir)
+y=pd.read_csv(f"{a.data_dir}/train_labels.csv")[["order_id","is_late"]]
+X=X.merge(y,on="order_id")
+cats=list(X.customer_state.cat.categories)
+m=lgb.LGBMClassifier(verbose=-1).fit(X[cols],X.is_late)
+os.makedirs(a.model_dir,exist_ok=True)
+pickle.dump((m,cols,cats),open(f"{a.model_dir}/m.pkl","wb"))
