+K = 10
+
+def hist_train(o, lab):
+    """Past-only seller stats: only orders already delivered before this purchase count."""
+    lab = lab.copy()
+    lab["dd"] = pd.to_datetime(lab.delivered_customer_date)
+    o = o.merge(lab[["order_id", "is_late", "dd"]], on="order_id")
+    prior = o.is_late.mean()
+    n = np.zeros(len(o)); late = np.zeros(len(o))
+    pos = {i: k for k, i in enumerate(o.index)}
+    for sid, grp in o.groupby("seller_id"):
+        dg = grp.dropna(subset=["dd"]).sort_values("dd")
+        dts = dg.dd.values; cs = np.concatenate([[0], np.cumsum(dg.is_late.values)])
+        idx = np.searchsorted(dts, grp.order_purchase_timestamp.values, side="left")
+        ii = [pos[i] for i in grp.index]
+        n[ii] = idx; late[ii] = cs[idx]
+    o["seller_n"] = n
+    o["seller_late"] = (late + prior * K) / (n + K)
+    table = o.groupby("seller_id").agg(n=("is_late", "count"), late=("is_late", "sum"))
+    return o, table, prior
+
+def hist_apply(o, table, prior):
+    t = o[["seller_id"]].join(table, on="seller_id")
+    o["seller_n"] = t.n.fillna(0).values
+    o["seller_late"] = ((t.late.fillna(0) + prior * K) / (t.n.fillna(0) + K)).values
+    return o
+
 FEATS = ["n_items", "price", "freight", "est_days", "hour", "dow", "customer_state", "seller_state", "same_state", "n_sellers", "dist_km", "installments", "pay_value", "n_pay", "pay_type"]
